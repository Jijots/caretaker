{
  "name": "caretaker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Defacement detection for small websites (Caretaker), plus a read-only pre-launch security audit agent (security-pass).",
  "scripts": {
    "scan": "tsx src/index.ts",
    "caretaker": "tsx src/guard/cli.ts",
    "guard": "tsx src/guard/cli.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "openai": "^4.68.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
