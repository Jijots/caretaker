{
  "name": "security-pass-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A read-only tool-calling agent that runs a pre-launch security pass over a codebase and reports findings for a human to confirm.",
  "scripts": {
    "scan": "tsx src/index.ts",
    "guard": "tsx src/guard/cli.ts",
    "test": "node --import tsx --test \"src/guard/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "openai": "^4.68.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
