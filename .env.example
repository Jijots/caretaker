# Put ONE of these in .env. Groq has a free tier and is preferred automatically.
# Groq keys: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI keys: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile on groq, gpt-4o on openai.
MODEL=

# Local provider (--provider local). Defaults to Ollama's OpenAI-compatible endpoint.
LOCAL_BASE_URL=
LOCAL_API_KEY=

# ---- Caretaker, the guard module (npm run caretaker). See src/guard/README.md ----

# Journals and baselines. Keep this OFF the monitored host, and never inside a
# monitored web root: guard refuses to start if it is. Default ./.guard-data
GUARD_DATA_DIR=

# One *.site.json per monitored site. Default ./guard-sites
GUARD_SITES_DIR=

# 32+ characters. Turns the audit journal into an HMAC chain that someone who can
# write the file but lacks this key cannot forge. Do not store it on the monitored host.
GUARD_JOURNAL_KEY=
